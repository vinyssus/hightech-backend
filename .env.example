# Copier en .env (ne jamais commiter le vrai fichier)
DB_URL=jdbc:postgresql://localhost:5432/hitechdz
DB_USERNAME=hitechdz
DB_PASSWORD=change-me

# openssl rand -base64 48
JWT_SECRET=

# Origines exactes ou motifs (ex. https://*.lovable.app pour les prévisualisations)
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://hitech-dz-commerce-suite-kappa.vercel.app,https://hitech-momo-market.lovable.app
SERVER_PORT=8081

# console (dev) | smtp
MAIL_PROVIDER=console
MAIL_FROM=no-reply@hitech-dz.cm
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Mettre false en production
ADMIN_SEED_ENABLED=true

# Images (Cloudinary) : tableau de bord Cloudinary > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ou, à la place des trois : CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Catalogue de démonstration si la base est vide (toujours actif avec le profil dev)
SEED_CATALOG=false

# URL publique du serveur (notifications de paiement)
APP_PUBLIC_BASE_URL=https://hightech-backend.onrender.com

# Paiement en ligne : none | loov | sandbox (tests uniquement, aucun débit réel)
PAYMENT_PROVIDER=none
LOOV_APP_KEY=
LOOV_MERCHANT_KEY=
# PAYMENT_SANDBOX_SECRET=au-moins-16-caracteres
