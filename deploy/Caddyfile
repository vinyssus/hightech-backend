# Certificat HTTPS obtenu et renouvelé automatiquement (Let's Encrypt) pour {$DOMAIN} et www.{$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	# API (webhook Loov, appels directs) ; le site passe par son relais /backend
	handle /api/* {
		reverse_proxy api:8081
	}

	handle {
		reverse_proxy site:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
