# Copier en .env sur le serveur (cp env.prod.example .env && nano .env). NE JAMAIS le mettre dans GitHub.
# Les valeurs « Render » se copient depuis Render → hightech-backend → Environment.
# Une ligne commentée (#) garde la valeur par défaut : ne laissez jamais « NOM= » vide, décommentez seulement ce que vous remplissez.

# --- Domaine (enregistrements DNS A de DOMAIN et www.DOMAIN vers l'IP du serveur) ---
DOMAIN=exemple.cm

# --- Base de données (générée par setup-server.sh) ---
DB_USERNAME=hitechdz
DB_PASSWORD=

# --- Sécurité (générés par setup-server.sh) ---
JWT_SECRET=
RELAY_SECRET=

# --- Administrateur : laisser false si les données sont reprises de Render (le compte existe déjà) ---
ADMIN_SEED_ENABLED=false
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
SEED_CATALOG=false

# --- Images (Render) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- E-mails (Render) ---
# MAIL_PROVIDER=brevo            # console | smtp | brevo
# MAIL_FROM=
# MAIL_FROM_NAME=
# BREVO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Paiement Orange Money / MTN via Loov (Render) ---
# PAYMENT_PROVIDER=loov          # avec LOOV_API_KEY ; sans eux, seul le paiement à la livraison est proposé
# LOOV_API_KEY=
# LOOV_WEBHOOK_SECRET=

# --- Assistant IA (Render, facultatif) ---
# ANTHROPIC_API_KEY=
# ASSISTANT_SHOP_INFO=

# --- Bouton WhatsApp du site (chiffres seulement, indicatif 237 inclus) ---
# WHATSAPP_NUMBER=
